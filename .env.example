PORT=5000
URI=mongodb://localhost:27017/your-database-name

JWT_SECRET=replace-with-a-long-random-secret
ADMIN_JWT_SECRET=replace-with-a-different-long-random-secret

API_SECRET=replace-with-a-long-random-secret

CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloud-api-key
CLOUDINARY_API_SECRET=your-cloud-api-secret

# Backend-only key used once to promote the first admin to the single super admin.
# Generate a long random value, keep it secret, and NEVER expose it to the frontend
# (no VITE_ prefix, no client bundle, no API responses).
SUPER_ADMIN_ACTIVATION_KEY=replace-with-a-long-random-secret

# Optional: when set, POST /admin/register requires a matching `bootstrapKey` in the body.
# Leave empty to allow the very first admin to register without a key.
ADMIN_BOOTSTRAP_KEY=
